**/config/local.yaml
**/config/*.local.yaml

# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Application log files written by the logger's file appender. Anchored: an
# unanchored `logs/` would also match `assets/views/logs/`.
/logs/

# Capture JPEGs written by the capture worker into `settings.storage.dir`, which
# defaults to `captures/`. Anchored: an unanchored `captures/` would also match a
# directory of that name anywhere in the tree.
/captures/

# include cargo lock
!Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

*.sqlite
*.sqlite-*